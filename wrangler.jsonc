{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-telegram-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  // Set the value through Cloudflare Secrets or .dev.vars for local development.
  "secrets": {
    "required": ["API_KEY"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "NotificationHub"
      },
      {
        "name": "TENANTS",
        "class_name": "TenantRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NotificationHub"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TenantRegistry"]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/telegram/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": false,
    "traces": {
      "enabled": false
    }
  },
  "upload_source_maps": true,
  "placement": {
    "mode": "smart"
  }
}
