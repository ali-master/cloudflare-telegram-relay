# Existing, private S3-compatible bucket. Keep this path stable across releases.
CELLD_BUCKET=
AWS_REGION=us-east-1

# Leave empty for Amazon S3; otherwise use your provider's HTTPS S3 endpoint.
S3_ENDPOINT=
# Fill in both, or leave both empty when using the supported runtime credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, for temporary AWS credentials.
AWS_SESSION_TOKEN=

RELAY_IMAGE=relay-celld:0.6.3
# Relative paths are resolved from deploy/celld/compose.yaml.
RELAY_API_KEY_FILE=./secrets/API_KEY
RELAY_BIND_ADDRESS=127.0.0.1
RELAY_PORT=8080
# Use 1 only behind a trusted proxy that overwrites forwarded/client-IP headers.
CELLD_TRUST_FORWARDED_HEADERS=0
